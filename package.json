{
  "name": "demandflow-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd apps/backend && venv\\Scripts\\python -m uvicorn app.main:app --reload --port 8000",
    "dev:frontend": "cd apps/web && npm.cmd run dev",
    "install:all": "npm install && cd apps/web && npm install && cd ../../apps/backend && pip install -r requirements.txt"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
